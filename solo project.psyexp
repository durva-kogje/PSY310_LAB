        <Param val="if (key_resp.keys) {&amp;#10;    thisResp = key_resp.keys[0];&amp;#10;    psychoJS.experiment.addData(&quot;response&quot;, thisResp);&amp;#10;    correct = (thisResp === correct_key.toString());&amp;#10;    psychoJS.experiment.addData(&quot;correct&quot;, correct);&amp;#10;} else {&amp;#10;    psychoJS.experiment.addData(&quot;response&quot;, &quot;&quot;);&amp;#10;    psychoJS.experiment.addData(&quot;correct&quot;, false);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# key_resp is the keyboard component's name; adapt if different&amp;#10;if key_resp.keys:&amp;#10;    thisResp = key_resp.keys[0]&amp;#10;    thisExp.addData('response', thisResp)&amp;#10;    correct = (thisResp == str(correct_key))&amp;#10;    thisExp.addData('correct', correct)&amp;#10;else:&amp;#10;    thisExp.addData('response', '')&amp;#10;    thisExp.addData('correct', False)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
